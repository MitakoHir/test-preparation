#!/usr/bin/env python3
import subprocess
import sys

ROOT = "/workspace"
RUNNER = f"{ROOT}/check/run_tests.py"
TIME_LIMIT = 10
TIMEOUT_CODE = 5
TASKS = [f"{number:02d}" for number in range(1, 11)]


def normalize(raw):
    if raw.isdigit() and 1 <= int(raw) <= 10:
        return f"{int(raw):02d}"
    return None


def run(task, path, quiet=False):
    output = subprocess.DEVNULL if quiet else None
    try:
        return subprocess.run(
            [sys.executable, "-u", RUNNER, task, path],
            stdin=subprocess.DEVNULL,
            stdout=output,
            stderr=output,
            timeout=TIME_LIMIT,
        ).returncode
    except subprocess.TimeoutExpired:
        if not quiet:
            print(f"Решение не завершилось за {TIME_LIMIT} секунд: возможно, это бесконечный цикл.")
        return TIMEOUT_CODE


def show_progress():
    labels = {0: "зачёт", 2: "ошибка при запуске файла", TIMEOUT_CODE: "превышено время"}
    solved = 0
    for task in TASKS:
        code = run(task, f"{ROOT}/solutions/task_{task}.py", quiet=True)
        solved += code == 0
        print(f"  {task}  {labels.get(code, 'не сдано')}")
    print(f"\nРешено: {solved} из {len(TASKS)}")


def main():
    if len(sys.argv) == 1:
        show_progress()
        return 0
    task = normalize(sys.argv[1])
    if task is None:
        print("Номер задания должен быть от 1 до 10.")
        return 1
    path = sys.argv[2] if len(sys.argv) > 2 else f"{ROOT}/solutions/task_{task}.py"
    return run(task, path)


sys.exit(main())
